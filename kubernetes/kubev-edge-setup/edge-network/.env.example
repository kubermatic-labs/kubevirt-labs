# k8c-edge - configuration for the Justfile and for rendering k8c-edge.rsc
#
#   cp .env.example .env     and edit. .env is gitignored.
#
# Everything the router build depends on lives here. Change a value, run
# `just apply`, and the running config follows - nothing is hardcoded in the
# Justfile or in the .rsc template.

# --- how to reach the router -------------------------------------------------
CHATEAU_HOST=10.77.33.1
CHATEAU_USER=admin

# IPv6 link-local, the fallback that always works: it is L2-based, so it
# survives a subnet change, a lost lease and a half-applied config. This is the
# EUI-64 of the bridge MAC - regenerate it if you ever swap the hardware.
CHATEAU_HOST_LL=fe80::6f4:1cff:fef7:284c

# SSH private key. Leave empty to authenticate with the admin password instead
# (ssh will prompt). Must be an absolute path - no ~ expansion here.
CHATEAU_KEY=

# --- identity and housekeeping -----------------------------------------------
CHATEAU_IDENTITY=k8c-edge
CHATEAU_TZ=Europe/Berlin
CHATEAU_NTP=de.pool.ntp.org,pool.ntp.org

# Fixed resolvers, so name resolution survives an uplink switch. All WAN
# clients run use-peer-dns=no for the same reason.
CHATEAU_DNS=1.1.1.1,9.9.9.9

# --- the LAN -----------------------------------------------------------------
# Deliberately not a 192.168.x range: that collides with nearly every venue
# and home network you will plug this into.
CHATEAU_LAN_IP=10.77.33.1
CHATEAU_LAN_CIDR=24
CHATEAU_LAN_NET=10.77.33.0
CHATEAU_POOL=10.77.33.100-10.77.33.199

# --- interfaces --------------------------------------------------------------
# Silkscreen port labels do NOT match RouterOS names on this unit. Verify with
# /interface/bridge/host/print before changing this.
CHATEAU_WAN_IF=ether1
CHATEAU_RADIO_24=wlan1
CHATEAU_RADIO_5=wlan2
CHATEAU_LTE_IF=lte1

# --- wireless ----------------------------------------------------------------
# The lab's own AP. Its key stays in the defconf "default" profile and is not
# managed from here.
CHATEAU_LAN_AP=k8c_edge

# Profile that holds the credentials of the foreign network being used as an
# uplink. Kept separate from the local AP profile on purpose.
CHATEAU_UPLINK_PROFILE=wifi-uplink

# --- route priorities --------------------------------------------------------
# Lowest live distance wins. Wired beats WiFi beats LTE.
CHATEAU_DIST_WIRED=1
CHATEAU_DIST_WIFI=2
CHATEAU_DIST_LTE=3

# --- LTE ---------------------------------------------------------------------
# Carrier APN. Needs a SIM in the slot underneath before it does anything.
CHATEAU_APN=internet

# SIM PIN. RouterOS 7.20 does NOT persist this in the device config - it uses
# it to unlock once, then re-locks on the next modem re-initialisation. So
# `just lte-pin` re-supplies it from here.
# Better still: remove the PIN from the SIM in a phone. A lab router that boots
# unattended should not need a human to unlock its modem.
CHATEAU_SIM_PIN=

# --- venue uplink (optional) -------------------------------------------------
# Fill these in and `just wifi-up` joins without arguments. Leave WIFI_PASS
# empty to be prompted instead, which keeps it out of shell history.
# NOTE: these are someone else's credentials. .env is gitignored - keep it that
# way, and clear them when you leave the site.
WIFI_SSID=
WIFI_PASS=
WIFI_BAND=2.4

# --- BGP: MetalLB announcements from the KubeV cluster -----------------------
# The router learns LoadBalancer service addresses from the cluster over eBGP
# instead of the cluster having to ARP for them on the LAN.
#
# CHATEAU_BGP_POOL must NOT overlap CHATEAU_LAN_CIDR. It is a routed prefix:
# the router installs /32s from it pointing at the node, and LAN clients reach
# them through their normal default gateway.
#
# Both ASNs are from the private range (64512-65534).
CHATEAU_BGP_AS=64512
CHATEAU_BGP_PEER_AS=64513
CHATEAU_BGP_PEER=10.77.33.196
CHATEAU_BGP_LOCAL=10.77.33.1
CHATEAU_BGP_ROUTER_ID=10.77.33.1
CHATEAU_BGP_POOL=10.77.34.0/24

# Attach to foreign carriers. Required abroad; the factory default (no) means the
# modem silently refuses to register outside the home network. EU roaming is
# usually at domestic rates, elsewhere it is not.
CHATEAU_LTE_ROAMING=yes

# WPA2 key for the local k8c_edge AP. Leave EMPTY here - this file is committed.
# Empty means `just apply` leaves the existing profile alone instead of opening
# the AP, so set it in .env before building a router from scratch.
CHATEAU_LAN_AP_PSK=
