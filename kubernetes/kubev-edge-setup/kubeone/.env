# Configuration for the Justfile in this directory.
#
# Loaded automatically (`set dotenv-load`). A real environment variable wins
# over anything set here, so a one-off override needs no edit:
#
#   CLUSTER_NAME=my-test just status
#
# No secrets belong in this file - it is committed. Kubeconfig *paths* are fine;
# the files they point at are gitignored (*kubeconfig).

# --- identity ----------------------------------------------------------------
# CLUSTER_NAME must equal `name:` in kubeone.yaml, and INFRA_NAMESPACE must equal
# `cloudProvider.kubevirt.infraNamespace`. `just preflight` checks both.
CLUSTER_NAME=kubev-k1-edge
INFRA_NAMESPACE=kubermatic-virtualization

# --- infra cluster objects ---------------------------------------------------
# Subnet names must match infra/subnet-k1-cp.yaml; the LB names must match the release
# and IPPool in infra/helmfile.yaml.
CP_SUBNET=kubeone-demo-cp
WORKER_SUBNET=kubeone-demo-workers
API_LB=kubeone-demo-api-lb
API_VIP_POOL=kubeone-demo-api-vip

# The MetalLB Service that puts the API load balancer on the edge LAN
# (infra/api-lb-svc.yaml). API_LAN_VIP must match the metallb.io/loadBalancerIPs
# annotation there AND apiEndpoint.alternativeNames in kubeone.yaml - it is what
# `just kubeconfig` writes into the generated kubeconfig. It has to sit inside
# the MetalLB pool from kubermatic-virtualization/kubev/kubev.yaml
# (10.77.33.20-10.77.33.50); .20 is already the KubeV dashboard.
API_LAN_SVC=kubeone-demo-api-lb-lan
API_LAN_VIP=10.77.33.21

# SSH jump host into the kube-ovn subnets (ssh-bastion/). BASTION_VIP must match
# both the metallb.io/loadBalancerIPs annotation in
# ssh-bastion/01_bastion-svc.yaml and ssh.bastion in kubeone.yaml - KubeOne
# cannot reach a single VM without it. `just preflight` checks the drift.
BASTION_VIP=10.77.33.22
BASTION_USER=bastion

# --- kubeconfigs -------------------------------------------------------------
# Bare names resolve next to the Justfile; absolute paths are used as-is.
#
# KUBEV_KUBECONFIG is the INFRA cluster (the KubeVirt one) and is the one input
# you have to supply. The other two are generated.
KUBEV_KUBECONFIG=../kubermatic-virtualization/kubev-cluster-kubeconfig
SA_KUBECONFIG=infra/kubeone-infra-kubeconfig
CLUSTER_KUBECONFIG=kubev-k1-edge-kubeconfig

# The MetalLB address the Headlamp UI gets. The Service lives in the KubeOne
# cluster (helmReleases in kubeone.yaml); the KubeVirt CCM mirrors it into the
# infra cluster, annotations and all, and MetalLB pins it to this address.
# Must match the metallb.io/loadBalancerIPs annotation in kubeone.yaml -
# `just preflight` checks it. Fourth address of ippool-kubev: .20 dashboard,
# .21 kube-apiserver, .22 SSH bastion.
HEADLAMP_VIP=10.77.33.23

# Local port for `just headlamp-forward`, the fallback for when you are not on
# the lab LAN. 8081, not 8080, so it does not collide with `just ui`
# (`kubeone ui` binds 8080).
HEADLAMP_PORT=8081


# Guard for `just purge`. INFRA_NAMESPACE above is SHARED - on this box it also
# holds the KubeV control plane itself (kubev-api-server, kubev-dashboard,
# kubev-controller-manager) - so purge deletes only this cluster's own objects
# and leaves the namespace alone. Deleting it would take KubeV down with it. Set to true ONLY when the namespace is dedicated to this
# cluster and you want it gone.
PURGE_NAMESPACE=false
